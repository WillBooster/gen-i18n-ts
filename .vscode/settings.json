{
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.rulers": [120]
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.rulers": [120]
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/temp/**": true,
    "**/tmp/**": true
  },
  "githubPullRequests.defaultMergeMethod": "squash"
}
