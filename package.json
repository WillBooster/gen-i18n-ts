{
  "name": "gen-i18n-ts",
  "version": "0.0.0-semantically-released",
  "description": "A CLI tool to generate a strictly-typed i18n object literal written in TypeScript from JSON files.",
  "keywords": [
    "TypeScript",
    "i18n",
    "internationalization"
  ],
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/gen-i18n-ts.git"
  },
  "bin": "./bin/index.js",
  "files": [
    "bin/",
    "dist/"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "build-ts app",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "start": "bun src/index.ts --",
    "start-prod": "bun run build && bun run gen-i18n-ts",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "dependencies": {
    "js-yaml": "5.5.0",
    "yargs": "18.2.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/helper-plugin-utils": "8.0.1",
    "@babel/node": "8.0.6",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-numeric-separator": "7.18.6",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-typescript": "8.0.7",
    "@tsconfig/bun": "1.0.11",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/node-ts": "23.6.4",
    "@types/bun": "1.4.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.5",
    "@types/yargs": "17.0.35",
    "@willbooster/babel-configs": "2.5.1",
    "@willbooster/oxlint-config": "1.4.9",
    "@willbooster/wb": "22.29.3",
    "babel-plugin-transform-remove-console": "6.9.4",
    "build-ts": "21.0.29",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "lefthook": "2.2.2",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "semantic-release": "25.0.9",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
